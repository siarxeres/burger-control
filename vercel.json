{
  "outputDirectory": "public",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/beta", "dest": "/beta.html" },
    { "src": "/beta.html", "dest": "/beta.html" },
    { "src": "/pricing", "dest": "/pricing.html" },
    { "src": "/pricing.html", "dest": "/pricing.html" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/admin.html", "dest": "/admin.html" },
    { "src": "/obrigado", "dest": "/obrigado.html" },
    { "src": "/obrigado.html", "dest": "/obrigado.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
